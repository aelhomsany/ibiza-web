# Leave empty so Vite proxies /api to localhost:8080 (cookies work)
VITE_API_URL=

# E2E / Playwright
TEST_ENV=local
BASE_URL=http://localhost:5173

# Cloudflare's documented always-passes TEST key, the same one CI uses. Without it
# `npm run build:public` fails closed, so the marketing site cannot be built or previewed.
VITE_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

VITE_API_URL=http://localhost:8080

# Required to build dist/public. `npm run build` fails closed without it, because a missing
# site key silently disables the Turnstile widget and makes every Contact Sales submission
# fail server validation. The value below is Cloudflare's documented always-passes TEST key
# and is what CI uses (.github/workflows/ci.yml sets it workflow-wide); real deployments must
# supply their own. Copying this file to .env is enough to make a local build work.
VITE_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# E2E / Playwright
TEST_ENV=local
BASE_URL=http://localhost:5173
API_URL=http://localhost:8080
E2E_USER_EMAIL=alex@company.com
E2E_USER_PASSWORD=PilotDev123!
# Set to true when ibiza-api is running to enable API auth E2E checks
E2E_API_AVAILABLE=false
# Set true (or run npm run test:e2e:api) when ibiza-api is on :8080 to run API-dependent E2E

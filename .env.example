VITE_API_URL=http://localhost:8080

# Required to build dist/public. `npm run build` fails closed without it, because a missing
# site key silently disables the Turnstile widget and makes every Contact Sales submission
# fail server validation. The value below is Cloudflare's documented always-passes TEST key
# and is what CI uses (.github/workflows/ci.yml sets it workflow-wide); real deployments must
# supply their own. Copying this file to .env is enough to make a local build work.
VITE_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Origin of the customer app, used for the public site's "Customer Log In" links. Leave empty for
# a single-host deployment; set it wherever the marketing site and the app are separate origins,
# which is what scripts/run-dev-journey.sh does locally.
VITE_PUBLIC_APP_BASE_URL=

# E2E / Playwright
TEST_ENV=local
BASE_URL=http://localhost:5173
API_URL=http://localhost:8080
E2E_USER_EMAIL=alex@company.com
E2E_USER_PASSWORD=PilotDev123!
# Set to true when leaveo-api is running to enable API auth E2E checks
E2E_API_AVAILABLE=false
# Set true (or run npm run test:e2e:api) when leaveo-api is on :8080 to run API-dependent E2E

# Client-side kill switches. Both act ONLY on the literal string "false"; absent means
# enabled, which is the normal state. VITE_PUBLIC_ANALYTICS_ENABLED=false stops the public
# site loading any analytics (the rollback lever); VITE_PUBLIC_CTA_ENABLED=false hides every
# sign-up call to action, leaving the marketing pages readable with no way in. Both are read
# at build time and baked into the bundle, so flipping either needs a rebuild.
#VITE_PUBLIC_ANALYTICS_ENABLED=true
#VITE_PUBLIC_CTA_ENABLED=true
